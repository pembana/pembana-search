<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Preserve upstream JUnit assertions; do not require an unrelated AssertJ migration. -->
    <suppress files="[/\\]src[/\\]test[/\\]java[/\\]"
              checks="RegexpSinglelineJavaCheck" message="Please use AssertJ imports\."/>
</suppressions>
